<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions the SDK needs. INTERNET, ACCESS_NETWORK_STATE, VIBRATE and CAMERA
         are already declared in the AAR manifest and get merged, but listing them
         makes it obvious what is required. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Only needed for advertising-ID based attribution (optional). -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!-- For broadcasting (Mission 8). RECORD_AUDIO is not in the AAR, so the app must
         declare it. The runtime request itself is made by ShopliveStreamer.start(). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".DemoApplication"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShopliveOnboarding">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ShopliveOnboarding"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Mission 2 — the deep-link entry point.
             shoplivedemo://live?campaign={CAMPAIGN_KEY}&ref={REFERRER}
             For cold-start safety this screen only parses and hands over to
             MainActivity. -->
        <activity
            android:name=".SchemeActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/Theme.ShopliveOnboarding.Transparent">
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="live"
                    android:scheme="${deepLinkScheme}" />
            </intent-filter>
        </activity>

        <!-- Mission 6 — where a navigation(url) request lands.
             It has to open while the SDK player Activity is front-most, which is why it
             is an Activity and not a Compose route. -->
        <activity
            android:name=".ProductDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.ShopliveOnboarding" />
    </application>
</manifest>
