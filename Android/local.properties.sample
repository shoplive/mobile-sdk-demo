# Copy local.properties.sample → local.properties and fill in the values.
# local.properties is in .gitignore, so it never gets committed.
#
# Nothing in here is required to build. The SDK comes from a public Maven
# repository (https://github.com/shoplive/shoplive-sdk-android, maven-repo branch),
# so there are no credentials to fill in.

# Android SDK location (Android Studio fills this in for you)
#sdk.dir=/Users/<you>/Library/Android/sdk

# ── Demo keys for "take a tour" mode (optional) ──────────────────────────────
# Left empty, the app falls back to the demo account checked into the repo
# (demo/DemoDefaults.kt). Set them to run the missions against your own account.
# Without streamToken only Mission 8 (going live) stays locked.
shoplive.demo.accessKey=
shoplive.demo.campaignKey=
shoplive.demo.streamToken=

# ── SDK developers only: build against local SDK sources ────────────────────
# Replaces the published AAR with a matrix-sdk-android checkout (composite build).
#shoplive.sdk.useLocal=true
#shoplive.sdk.localPath=../matrix-sdk-android
