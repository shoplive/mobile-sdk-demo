# Copy local.properties.sample → local.properties and fill in the values.
# local.properties is in .gitignore, so it never gets committed.

# Android SDK location (Android Studio fills this in for you)
#sdk.dir=/Users/<you>/Library/Android/sdk

# ── Shoplive private Maven credentials (required) ────────────────────────────
# Use the values issued by your ShopLive contact.
shoplive.maven.username=
shoplive.maven.password=

# Only needed for the customer-distribution repository (the default is the development repo.us1)
#shoplive.maven.url=https://repo-mig.us1.shoplive.cloud/repository/shoplive/

# ── Demo keys for "take a tour" mode (optional) ──────────────────────────────
# Left empty, the app's "take a tour · start now" is locked and you have to type the keys in.
# Without streamToken only Mission 8 (going live) stays locked.
shoplive.demo.accessKey=
shoplive.demo.campaignKey=
shoplive.demo.streamToken=
